{
  "appId": "com.discipline.habittracker",
  "appName": "Discipline",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.firebaseapp.com",
      "*.googleapis.com",
      "accounts.google.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#7C6FF7",
      "sound": "beep.wav"
    }
  }
}
